# Core — required for local development
DATABASE_URL="postgresql://user:password@localhost:5432/estatedesk"
DIRECT_URL="postgresql://user:password@localhost:5432/estatedesk"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

NEXT_PUBLIC_STATUS_PAGE_URL=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_ENABLE_WEB_VITALS="false"
NEXT_PUBLIC_ANALYTICS_DEBUG="false"

# Developer ergonomics — keep local Neon/DB quiet (off by default)
NEXT_PUBLIC_DEV_BACKGROUND_REFRESH="false"
DEV_LOGIN_TIMING="false"
DEV_DEBUG_LOGS="false"

# Performance and scale guardrails
PRISMA_POOL_MAX="15"
PRISMA_CONNECTION_TIMEOUT_MS="30000"
PRISMA_IDLE_TIMEOUT_MS="60000"
PRISMA_QUERY_TIMEOUT_MS="60000"
SYNC_EXPORT_ROW_LIMIT="50000"

# Security — required in production
AUTH_SECRET="replace-with-32-plus-char-random-secret"
# Keeps server action IDs stable across dev restarts (openssl rand -base64 32)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32-output"
CRON_SECRET="replace-with-random-cron-secret"
PLATFORM_API_KEYS_PAGE_PASSWORD="replace-with-strong-password"

# Observability
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
ALERT_WEBHOOK_URL=""
SECURITY_ALERT_WEBHOOK_URL=""

# Storage — required when uploads or receipts are enabled
S3_BUCKET="your-s3-bucket"
S3_REGION="af-south-1"
S3_ENDPOINT=""
S3_PUBLIC_BASE_URL=""
S3_ACCESS_KEY_ID="replace-with-access-key"
S3_SECRET_ACCESS_KEY="replace-with-secret-key"

# Messaging
# Generate keys with: npm run generate:web-push-keys
# Optional local PWA testing: NEXT_PUBLIC_ENABLE_PWA_IN_DEV="true"
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:support@your-domain.example"
WHATSAPP_PROVIDER="meta"
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_DISPLAY_NAME="EstateDesk"
WHATSAPP_GRAPH_VERSION="v20.0"
WHATSAPP_TEMPLATE_LANGUAGE="en"
WHATSAPP_INVITE_TEMPLATE_NAME=""
WHATSAPP_CREDENTIALS_TEMPLATE_NAME=""

# Integration approval placeholders
KRA_ETIMS_ENVIRONMENT="sandbox"
KRA_ETIMS_BASE_URL=""
KRA_ETIMS_CLIENT_ID=""
KRA_ETIMS_CLIENT_SECRET=""
KRA_ETIMS_WEBHOOK_SECRET=""

