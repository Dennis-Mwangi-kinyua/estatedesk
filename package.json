{
  "name": "estatedesk",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @estatedesk/web",
    "build": "npm run build -w @estatedesk/web",
    "start": "npm run start -w @estatedesk/web",
    "lint": "npm run lint -w @estatedesk/web",
    "typecheck": "npm run typecheck -w @estatedesk/web",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/**/*.integration.ts",
    "load:test": "node scripts/load-test.mjs",
    "backup:database": "bash scripts/backup-database.sh",
    "backup:validate": "bash scripts/validate-backup.sh",
    "restore:drill": "bash scripts/restore-drill.sh",
    "production:check": "node scripts/production-readiness-check.mjs",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "qa:tenant-portal": "npm run qa:tenant-portal -w @estatedesk/web",
    "generate:web-push-keys": "node scripts/generate-web-push-keys.mjs",
    "extension:package": "mkdir -p dist && rm -f dist/estatedesk-browser-extension.zip && cd extensions/estatedesk && zip -r ../../dist/estatedesk-browser-extension.zip ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1018.0",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "react-icons": "^5.5.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "playwright": "^1.49.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
