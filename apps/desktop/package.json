{
  "name": "@estatedesk/desktop",
  "version": "0.2.1",
  "private": true,
  "description": "EstateDesk desktop workspace",
  "author": "EstateDesk",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "electron-builder --publish never",
    "package:dir": "electron-builder --dir --publish never"
  },
  "build": {
    "appId": "ke.co.estatedesk.desktop",
    "productName": "EstateDesk",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "policy.cjs",
      "permissions.cjs",
      "updates.cjs",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSCameraUsageDescription": "Use the camera for property report photos and visitor QR scanning."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "syncDesktopName": true,
      "icon": "../web/public/icons/icon-512.png",
      "maintainer": "EstateDesk",
      "artifactName": "EstateDesk-${version}-${arch}.${ext}"
    },
    "npmRebuild": false,
    "executableName": "estatedesk",
    "deb": {
      "packageName": "estatedesk"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://estatedesk.co.ke/downloads/desktop/"
      }
    ]
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "^26.18.0"
  },
  "desktopName": "estatedesk.desktop",
  "homepage": "https://estatedesk.co.ke",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
