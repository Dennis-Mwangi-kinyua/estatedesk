// Hardened Prisma schema for EstateDesk.
// Focus: production-safe indexing, clear documentation, and preserved app structure/functionality.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Application user account. May belong to many organizations through Membership.
model User {
  id                        String                  @id @default(cuid())
  fullName                  String
  phone                     String?                 @unique
  email                     String?                 @unique
  passwordHash              String
  status                    UserStatus              @default(ACTIVE)
  platformRole              PlatformRole            @default(USER)
  canCreatePlatformAdmins   Boolean                 @default(false)
  isRootSuperAdmin          Boolean                 @default(false)
  emailVerified             DateTime?
  phoneVerified             DateTime?
  mustChangePassword        Boolean                 @default(false)
  passwordChangedAt         DateTime?
  termsAcceptedAt           DateTime?
  termsAcceptedVersion      String?
  twoFactorEnabled          Boolean                 @default(false)
  lastLoginAt               DateTime?
  deletedAt                 DateTime?
  createdByUserId           String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  username                  String?                 @unique
  slug                      String?                 @unique
  createdApiKeys            ApiKey[]                @relation("CreatedBy")
  dataExportRequests        DataExportRequest[]     @relation("DataExportRequestedBy")
  dataExportReviews         DataExportRequest[]     @relation("DataExportReviewedBy")
  issuedDocuments           DocumentRecord[]        @relation("DocumentIssuedBy")
  documentEvents            DocumentEvent[]         @relation("DocumentEventActor")
  uploadedAssets            Asset[]                 @relation("AssetUploader")
  auditLogs                 AuditLog[]              @relation("AuditActor")
  caretakerAssignments      CaretakerAssignment[]   @relation("CaretakerUser")
  inspections               Inspection[]            @relation("InspectionInspector")
  invitedUsers              Invitation[]            @relation("InvitedBy")
  issuesAssignedBy          IssueTicket[]           @relation("IssueAssignedBy")
  issuesAssigned            IssueTicket[]           @relation("IssueAssignedTo")
  issuesReported            IssueTicket[]           @relation("IssueReportedBy")
  issueResolutionReports    IssueResolutionReport[] @relation("IssueResolutionReportCaretaker")
  issueReportsReviewed      IssueResolutionReport[] @relation("IssueResolutionReportOfficeReviewer")
  issueReportsConfirmed     IssueResolutionReport[] @relation("IssueResolutionReportTenantConfirmer")
  landlordProfiles          LandlordProfile[]
  caretakerLeases           Lease[]                 @relation("LeaseCaretaker")
  memberships               Membership[]
  meterReadingsApproved     MeterReading[]          @relation("MeterReadingApprovedBy")
  meterReadingsSubmitted    MeterReading[]          @relation("MeterReadingSubmittedBy")
  notifications             Notification[]          @relation("NotificationUser")
  paymentsMade              Payment[]               @relation("PaymentPayerUser")
  pushSubscriptions         PushSubscription[]
  reconciledPayments        Payment[]               @relation("PaymentReconciledBy")
  reversedPayments          Payment[]               @relation("PaymentReversedBy")
  cronJobRuns               CronJobRun[]            @relation("CronJobRunActor")
  platformPermissions       PlatformPermission[]
  platformMessagesSent      PlatformMessage[]
  onboardingRequestsHandled OnboardingRequest[]     @relation("OnboardingRequestHandledBy")
  submittedRentalReturns    RentalIncomeReturn[]    @relation("RentalReturnSubmittedBy")
  accountingRequestsSubmitted AccountingRequest[]   @relation("AccountingRequestSubmittedBy")
  accountingRequestsReviewed  AccountingRequest[]   @relation("AccountingRequestReviewedBy")
  accountingRequestEvents     AccountingRequestEvent[] @relation("AccountingRequestEventActor")
  tenant                    Tenant?
  tenantActionLogs          TenantActionLog[]       @relation("TenantActionActor")
  tenantTransfersApproved   TenantTransferRequest[] @relation("TenantTransferReviewedBy")
  tenantTransfersRequested  TenantTransferRequest[] @relation("TenantTransferRequestedBy")
  createdBy                 User?                   @relation("UserCreatedBy", fields: [createdByUserId], references: [id])
  createdUsers              User[]                  @relation("UserCreatedBy")
  sessions                  UserSession[]

  @@index([username])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([platformRole])
  @@index([deletedAt])
  @@index([createdByUserId])
  @@index([isRootSuperAdmin])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([lastLoginAt])
}

/// Server-side user session with active organization membership context.
model UserSession {
  id                 String      @id @default(cuid())
  userId             String
  userAgent          String?
  ipAddress          String?
  createdAt          DateTime    @default(now())
  lastSeenAt         DateTime    @default(now())
  expiresAt          DateTime
  activeMembershipId String?
  tokenHash          String      @unique
  activeMembership   Membership? @relation(fields: [activeMembershipId], references: [id])
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([expiresAt])
  @@index([activeMembershipId])
  @@index([userId, expiresAt])
  @@index([activeMembershipId, expiresAt])
}

/// Platform-level permission override for super-admin capabilities.
model PlatformPermission {
  id         String                 @id @default(cuid())
  userId     String
  permission PlatformPermissionType
  granted    Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@index([permission])
}

/// Shared rate-limit bucket for short-lived security and workflow throttles.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

/// Singleton platform-wide kill switches and developer control-plane state.
model PlatformControl {
  id                    String    @id @default("global")
  maintenanceMode       Boolean   @default(false)
  maintenanceMessage    String?
  incidentMode          Boolean   @default(false)
  incidentMessage       String?
  publicSignupDisabled  Boolean   @default(false)
  publicApiDisabled     Boolean   @default(false)
  webhooksDisabled      Boolean   @default(false)
  cronDisabled          Boolean   @default(false)
  tenantPortalsDisabled Boolean   @default(false)
  orgDashboardsDisabled Boolean   @default(false)
  globalFeatures        Json?
  notes                 String?
  lastBackupAt          DateTime?
  lastBackupNote        String?
  lastBackupStatus      String?
  updatedByUserId       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// Inbound webhook samples for developer debugging.
model PlatformWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  path        String
  statusCode  Int
  summary     String?
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([provider, createdAt])
  @@index([createdAt])
}

/// Tenant organization / property management company boundary.
model Organization {
  id                      String                    @id @default(cuid())
  name                    String
  slug                    String                    @unique
  phone                   String?
  email                   String?
  address                 String?
  status                  OrganizationStatus        @default(ACTIVE)
  currencyCode            String                    @default("KES")
  timezone                String                    @default("Africa/Nairobi")
  dataRetentionDays       Int                       @default(2555)
  deletedAt               DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  marketerId              String?
  referralCode            String?
  commissionRate          Decimal?                  @db.Decimal(5, 2)
  commissionStatus        MarketingCommissionStatus @default(PENDING)
  commissionNotes         String?
  apiKeys                 ApiKey[]
  accountingAccounts      AccountingAccount[]
  accountingPeriods       AccountingPeriod[]
  accountingRequests      AccountingRequest[]
  accountingSettings      AccountingSettings?
  bankAccounts            AccountingBankAccount[]
  bankReconciliations     AccountingBankReconciliation[]
  budgets                 AccountingBudget[]
  journalEntries          AccountingJournalEntry[]
  taxCodes                AccountingTaxCode[]
  vendors                 AccountingVendor[]
  vendorBills             AccountingVendorBill[]
  assets                  Asset[]
  auditLogs               AuditLog[]
  caretakerAssignments    CaretakerAssignment[]
  dataExportRequests      DataExportRequest[]
  documentRecords         DocumentRecord[]
  documentEvents          DocumentEvent[]
  expenditures            Expenditure[]
  invitations             Invitation[]
  importRuns              ImportRun[]
  issues                  IssueTicket[]
  issueResolutionReports  IssueResolutionReport[]
  kraIntegration          KraIntegration?
  landlordAssignments     LandlordAssignment[]
  landlordProfiles        LandlordProfile[]
  marketer                PlatformMarketer?         @relation(fields: [marketerId], references: [id])
  leases                  Lease[]
  leaseSignatureEnvelopes LeaseSignatureEnvelope[]
  memberships             Membership[]
  notifications           Notification[]
  platformMessages        PlatformMessage[]
  settings                OrganizationSettings?
  payments                Payment[]
  paymentAllocations      PaymentAllocation[]
  properties              Property[]
  rentCharges             RentCharge[]
  rentalReturns           RentalIncomeReturn[]
  reportExports           ReportExport[]
  vacancyInquiries        VacancyInquiry[]
  subscription            Subscription?
  taxCharges              TaxCharge[]
  taxpayerProfiles        TaxpayerProfile[]
  tenants                 Tenant[]
  tenantActionLogs        TenantActionLog[]
  tenantHistoryRecords    TenantHistoryRecord[]
  tenantTransfersIn       TenantTransferRequest[]   @relation("TenantTransferTargetOrg")
  tenantTransfersOut      TenantTransferRequest[]   @relation("TenantTransferSourceOrg")
  waterBills              WaterBill[]

  @@index([slug])
  @@index([status])
  @@index([name])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([marketerId])
  @@index([referralCode])
  @@index([commissionStatus])
}

/// CSV import attempt for onboarding and migration auditability.
model ImportRun {
  id              String       @id @default(cuid())
  orgId           String
  actorUserId     String
  kind            String
  mode            String
  status          String
  totalRows       Int          @default(0)
  validRows       Int          @default(0)
  createdRows     Int          @default(0)
  errorCount      Int          @default(0)
  errors          Json?
  rowResults      Json?
  rollbackSummary String?
  createdAt       DateTime     @default(now())
  completedAt     DateTime?
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([kind, createdAt])
  @@index([status, createdAt])
}

/// Report export request archive for operational download history.
model ReportExport {
  id          String       @id @default(cuid())
  orgId       String
  actorUserId String
  reportType  String
  period      String?
  fileName    String
  status      String       @default("COMPLETED")
  metadata    Json?
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([reportType, createdAt])
}

/// Message sent by an organization to platform administrators.
model PlatformMessage {
  id           String       @id @default(cuid())
  orgId        String
  senderUserId String
  subject      String
  message      String
  status       String       @default("OPEN")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id])

  @@index([orgId, createdAt])
  @@index([senderUserId, createdAt])
  @@index([status, createdAt])
}

/// Public onboarding request submitted from the registration/access page.
model OnboardingRequest {
  id                  String                    @id @default(cuid())
  fullName            String
  companyName         String
  workEmail           String
  phone               String?
  managedPropertyType String
  message             String?
  status              String                    @default("NEW")
  internalNotes       String?
  handledAt           DateTime?
  handledByUserId     String?
  marketerId          String?
  referralCode        String?
  commissionRate      Decimal?                  @db.Decimal(5, 2)
  commissionStatus    MarketingCommissionStatus @default(PENDING)
  commissionNotes     String?
  source              String                    @default("REGISTER_PAGE")
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  handledBy           User?                     @relation("OnboardingRequestHandledBy", fields: [handledByUserId], references: [id])
  marketer            PlatformMarketer?         @relation(fields: [marketerId], references: [id])

  @@index([status, createdAt])
  @@index([workEmail, createdAt])
  @@index([handledByUserId, handledAt])
  @@index([marketerId])
  @@index([referralCode])
  @@index([commissionStatus])
  @@index([createdAt])
}

/// Platform-side marketer/referral partner used to attribute leads and customers.
model PlatformMarketer {
  id                    String              @id @default(cuid())
  fullName              String
  email                 String?
  phone                 String?
  referralCode          String              @unique
  defaultCommissionRate Decimal             @default(0) @db.Decimal(5, 2)
  status                MarketerStatus      @default(ACTIVE)
  notes                 String?
  deletedAt             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  onboardingRequests    OnboardingRequest[]
  organizations         Organization[]

  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
}

/// Auditable request for an organization-scoped CSV data export.
model DataExportRequest {
  id                String                  @id @default(cuid())
  orgId             String
  requestedByUserId String
  reviewedByUserId  String?
  status            DataExportRequestStatus @default(PENDING)
  reason            String?
  reviewerNotes     String?
  requestedAt       DateTime                @default(now())
  reviewedAt        DateTime?
  expiresAt         DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  org               Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requestedBy       User                    @relation("DataExportRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy        User?                   @relation("DataExportReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([orgId, status, requestedAt])
  @@index([requestedByUserId, requestedAt])
  @@index([reviewedByUserId, reviewedAt])
  @@index([status, requestedAt])
  @@index([expiresAt])
}

/// Organization-specific configurable settings and feature flags.
model OrganizationSettings {
  id                   String       @id @default(cuid())
  orgId                String       @unique
  branding             Json?
  features             Json?
  customFields         Json?
  notificationDefaults Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  org                  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// Billing subscription for an organization.
model Subscription {
  id                   String                   @id @default(cuid())
  orgId                String                   @unique
  plan                 BillingPlan              @default(FREE)
  status               SubscriptionStatus       @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAt             DateTime?
  cancelledAt          DateTime?
  trialStartsAt        DateTime?
  trialEndsAt          DateTime?
  mpesaPaybill         String?
  stripeSubscriptionId String?                  @unique
  billingEmail         String?
  metadata             Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  org                  Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planChanges          SubscriptionPlanChange[]

  @@index([plan])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([orgId, status])
}

/// Historical subscription plan transition record.
model SubscriptionPlanChange {
  id             String       @id @default(cuid())
  subscriptionId String
  fromPlan       BillingPlan?
  toPlan         BillingPlan
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  reason         String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([toPlan])
  @@index([effectiveFrom])
}

/// Uploaded file or media asset owned by an organization.
model Asset {
  id               String         @id @default(cuid())
  orgId            String
  unitId           String?
  fileName         String
  fileType         String
  mimeType         String?
  key              String
  size             Int
  metadata         Json?
  assetType        AssetType      @default(GENERIC)
  uploadedByUserId String
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  org              Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploadedBy       User           @relation("AssetUploader", fields: [uploadedByUserId], references: [id])
  issuePhotos      IssueTicket[]  @relation("IssuePhoto")
  lease            Lease?         @relation("LeaseContract")
  meterReadings    MeterReading[] @relation("MeterPhoto")
  tenant           Tenant?        @relation("TenantProfileImage")
  unit             Unit?          @relation("UnitImages", fields: [unitId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([unitId])
  @@index([assetType])
  @@index([key])
  @@index([deletedAt])
  @@index([orgId, createdAt])
  @@index([orgId, assetType, createdAt])
}

/// Immutable identity and verification record for an official generated document.
model DocumentRecord {
  id               String          @id @default(cuid())
  orgId            String
  serialNumber     String          @unique
  verificationCode String          @unique
  documentType     DocumentType
  entityType       String
  entityId         String
  version          Int             @default(1)
  status           DocumentStatus  @default(ISSUED)
  title            String
  mimeType         String          @default("application/pdf")
  contentHash      String?
  issuedByUserId   String?
  issuedAt         DateTime        @default(now())
  expiresAt        DateTime?
  supersededAt     DateTime?
  revokedAt        DateTime?
  revocationReason String?
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  org              Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  issuedBy         User?           @relation("DocumentIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  events           DocumentEvent[]
  receipt          Receipt?

  @@unique([orgId, documentType, entityType, entityId, version])
  @@index([orgId, documentType, issuedAt])
  @@index([orgId, status, issuedAt])
  @@index([entityType, entityId])
  @@index([contentHash])
  @@index([issuedByUserId, issuedAt])
}

/// Append-only evidence trail for document lifecycle and access events.
model DocumentEvent {
  id          String            @id @default(cuid())
  orgId       String
  documentId  String
  eventType   DocumentEventType
  actorUserId String?
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  document    DocumentRecord    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor       User?             @relation("DocumentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([orgId, eventType, createdAt])
  @@index([actorUserId, createdAt])
}

/// Organization role assignment with optional scoped access.
model Membership {
  id                   String        @id @default(cuid())
  orgId                String
  userId               String
  role                 OrgRole
  scopeType            ScopeType     @default(ORG)
  scopeId              String        @default("ORG_SCOPE")
  employmentStartedAt  DateTime      @default(now())
  employmentEndedAt    DateTime?
  employmentExitReason String?
  deactivatedAt        DateTime?
  deactivatedByUserId  String?
  deactivationNotes    String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  org                  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffProfile         StaffProfile?
  sessions             UserSession[]

  @@unique([orgId, userId, role, scopeType, scopeId])
  @@index([orgId])
  @@index([userId])
  @@index([role])
  @@index([scopeType, scopeId])
  @@index([userId, orgId, role])
  @@index([userId, role, createdAt])
  @@index([orgId, role, scopeType, scopeId])
  @@index([orgId, employmentEndedAt])
  @@index([userId, employmentEndedAt])
}

/// HR profile details tied to a staff membership.
model StaffProfile {
  id               String     @id @default(cuid())
  membershipId     String     @unique
  salaryAmount     Decimal?   @db.Decimal(12, 2)
  salaryCurrency   String     @default("KES")
  educationLevel   String?
  jobTitle         String?
  nationalId       String?
  emergencyContact String?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  membership       Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([salaryCurrency])
  @@index([educationLevel])
}

/// KRA taxpayer identity used for rental income tax workflows.
model TaxpayerProfile {
  id            String               @id @default(cuid())
  orgId         String
  displayName   String
  kraPin        String
  kind          TaxpayerKind         @default(INDIVIDUAL)
  email         String?
  phone         String?
  nationalId    String?
  companyRegNo  String?
  isResident    Boolean              @default(true)
  isActive      Boolean              @default(true)
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  landlords     LandlordProfile[]
  properties    Property[]
  rentalReturns RentalIncomeReturn[]
  org           Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, kraPin])
  @@index([orgId])
  @@index([kraPin])
  @@index([isResident])
  @@index([isActive])
  @@index([deletedAt])
  @@index([orgId, isActive, deletedAt])
}

/// KRA integration credentials and synchronization state.
model KraIntegration {
  id                      String            @id @default(cuid())
  orgId                   String            @unique
  filingMode              KraFilingMode     @default(HYBRID)
  environment             KraEnvironment    @default(SANDBOX)
  clientId                String?
  clientSecretCiphertext  String?
  accessTokenCiphertext   String?
  refreshTokenCiphertext  String?
  tokenExpiresAt          DateTime?
  apiBaseUrl              String?
  eritsBaseUrl            String?
  webhookSecretCiphertext String?
  status                  IntegrationStatus @default(ACTIVE)
  lastSyncAt              DateTime?
  lastError               String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  org                     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([environment])
}

/// Real estate property owned or managed by an organization.
model Property {
  id                      String                   @id @default(cuid())
  orgId                   String
  name                    String
  location                String?
  address                 String?
  notes                   String?
  type                    PropertyType             @default(RESIDENTIAL)
  waterRatePerUnit        Decimal?                 @db.Decimal(10, 2)
  waterFixedCharge        Decimal?                 @db.Decimal(10, 2)
  isActive                Boolean                  @default(true)
  deletedAt               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  taxpayerProfileId       String?
  buildings               Building[]
  caretakerAssignments    CaretakerAssignment[]
  issues                  IssueTicket[]
  landlordAssignments     LandlordAssignment[]
  org                     Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  taxpayerProfile         TaxpayerProfile?         @relation(fields: [taxpayerProfileId], references: [id])
  unitPlans               PropertyUnitPlan[]
  rentalReturns           RentalIncomeReturn[]
  rentalIncomeReturnItems RentalIncomeReturnItem[]
  taxCharges              TaxCharge[]
  units                   Unit[]

  @@unique([orgId, name])
  @@index([orgId])
  @@index([taxpayerProfileId])
  @@index([type])
  @@index([isActive])
  @@index([deletedAt])
  @@index([orgId, deletedAt])
  @@index([orgId, isActive, deletedAt, name])
}

/// Template used to generate multiple property units.
model PropertyUnitPlan {
  id                   String   @id @default(cuid())
  propertyId           String
  unitType             UnitType
  bedrooms             Int?
  bathrooms            Int?
  quantity             Int      @default(1)
  defaultRentAmount    Decimal  @db.Decimal(12, 2)
  defaultDepositAmount Decimal? @db.Decimal(12, 2)
  houseNoPrefix        String?
  startNumber          Int      @default(1)
  label                String?
  notes                String?
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  property             Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  units                Unit[]   @relation("PlanGeneratedUnits")

  @@index([propertyId])
  @@index([propertyId, unitType, bedrooms])
  @@index([propertyId, sortOrder])
}

/// Building/block inside a property.
model Building {
  id                   String                @id @default(cuid())
  propertyId           String
  name                 String
  notes                String?
  isActive             Boolean               @default(true)
  deletedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  property             Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  caretakerAssignments CaretakerAssignment[]
  units                Unit[]

  @@unique([propertyId, name])
  @@index([propertyId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([propertyId, isActive, deletedAt])
}

/// Rentable unit inside a property or building.
model Unit {
  id                   String                   @id @default(cuid())
  propertyId           String
  buildingId           String?
  houseNo              String
  type                 UnitType                 @default(APARTMENT)
  bedrooms             Int?
  bathrooms            Int?
  roomCount            Int?
  hasBalcony           Boolean                  @default(false)
  floorArea            Float?
  rentAmount           Decimal                  @db.Decimal(12, 2)
  depositAmount        Decimal?                 @db.Decimal(12, 2)
  serviceCharge        Decimal?                 @db.Decimal(12, 2)
  garbageFee           Decimal?                 @db.Decimal(12, 2)
  securityFee          Decimal?                 @db.Decimal(12, 2)
  electricityBilling   String?
  viewingFeeRequired   Boolean                  @default(false)
  viewingFeeAmount     Decimal?                 @db.Decimal(12, 2)
  status               UnitStatus               @default(VACANT)
  vacantSince          DateTime?
  notes                String?
  isActive             Boolean                  @default(true)
  deletedAt            DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  sequenceNo           Int?
  sourcePlanId         String?
  caretakerAssignments CaretakerAssignment[]
  issues               IssueTicket[]
  landlordAssignments  LandlordAssignment[]
  leases               Lease[]
  meterReadings        MeterReading[]
  rentalReturnItems    RentalIncomeReturnItem[]
  tenantActionLogs     TenantActionLog[]
  building             Building?                @relation(fields: [buildingId], references: [id])
  property             Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sourcePlan           PropertyUnitPlan?        @relation("PlanGeneratedUnits", fields: [sourcePlanId], references: [id])
  images               Asset[]                  @relation("UnitImages")
  vacancyInquiries     VacancyInquiry[]
  waterBills           WaterBill[]

  @@index([propertyId])
  @@index([buildingId])
  @@index([sourcePlanId])
  @@index([status])
  @@index([isActive])
  @@index([deletedAt])
  @@index([propertyId, isActive, deletedAt, status])
  @@index([propertyId, type, bedrooms, status])
  @@index([propertyId, houseNo])
  @@index([propertyId, createdAt])
  @@index([buildingId, status])
}

/// Public inquiry submitted from a vacant unit listing.
model VacancyInquiry {
  id        String       @id @default(cuid())
  orgId     String
  unitId    String
  fullName  String
  phone     String
  email     String?
  message   String
  status    String       @default("NEW")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit      Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([unitId, createdAt])
  @@index([status, createdAt])
}

/// Tenant profile; may optionally link to a user login account.
model Tenant {
  id               String                  @id @default(cuid())
  orgId            String
  userId           String?                 @unique
  type             TenantType              @default(INDIVIDUAL)
  fullName         String
  companyName      String?
  kraPin           String?
  phone            String
  email            String?
  nationalId       String?
  status           TenantStatus            @default(ACTIVE)
  notes            String?
  dataConsent      Boolean                 @default(false)
  consentUpdatedAt DateTime?
  marketingConsent Boolean                 @default(false)
  deletedAt        DateTime?
  profileImageId   String?                 @unique
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  archivedAt       DateTime?
  blacklistReason  String?
  blacklistedAt    DateTime?
  leases           Lease[]
  moveOutNotices   MoveOutNotice[]
  nextOfKin        NextOfKin?
  notifications    Notification[]          @relation("NotificationTenant")
  payments         Payment[]               @relation("PaymentPayerTenant")
  taxCharges       TaxCharge[]
  identityId       String?
  identity         TenantIdentity?         @relation(fields: [identityId], references: [id])
  org              Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  profileImage     Asset?                  @relation("TenantProfileImage", fields: [profileImageId], references: [id])
  user             User?                   @relation(fields: [userId], references: [id])
  actionLogs       TenantActionLog[]
  historyRecords   TenantHistoryRecord[]
  expenditures     Expenditure[]
  transferCopies   TenantTransferRequest[] @relation("TenantTransferCreatedTenant")
  transferRequests TenantTransferRequest[] @relation("TenantTransferSourceTenant")
  waterBills       WaterBill[]

  @@unique([orgId, phone])
  @@unique([orgId, email])
  @@index([orgId])
  @@index([status])
  @@index([fullName])
  @@index([nationalId])
  @@index([archivedAt])
  @@index([blacklistedAt])
  @@index([deletedAt])
  @@index([identityId])
  @@index([orgId, deletedAt, status])
  @@index([orgId, createdAt])
  @@index([orgId, updatedAt])
  @@index([orgId, status, fullName])
  @@index([orgId, phone])
  @@index([orgId, email])
}

/// Cross-organization identity used to connect tenant profiles that represent the same person/company.
model TenantIdentity {
  id             String                @id @default(cuid())
  displayName    String
  primaryPhone   String?
  primaryEmail   String?
  nationalId     String?
  kraPin         String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  historyRecords TenantHistoryRecord[]
  tenants        Tenant[]

  @@index([displayName])
  @@index([primaryPhone])
  @@index([primaryEmail])
  @@index([nationalId])
  @@index([kraPin])
  @@index([createdAt])
  @@index([updatedAt])
}

/// Durable tenancy history retained after move-out and available during future tenant verification/transfer.
model TenantHistoryRecord {
  id              String              @id @default(cuid())
  orgId           String
  tenantId        String
  identityId      String?
  leaseId         String?
  moveOutNoticeId String?
  status          TenantHistoryStatus @default(VACATED)
  propertyName    String?
  buildingName    String?
  unitHouseNo     String?
  leaseStartDate  DateTime?
  leaseEndDate    DateTime?
  moveOutDate     DateTime?
  monthlyRent     Decimal?            @db.Decimal(12, 2)
  deposit         Decimal?            @db.Decimal(12, 2)
  paymentCount    Int                 @default(0)
  totalPaid       Decimal             @default(0) @db.Decimal(12, 2)
  notes           String?
  snapshot        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  identity        TenantIdentity?     @relation(fields: [identityId], references: [id])
  org             Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([tenantId, createdAt])
  @@index([identityId, createdAt])
  @@index([leaseId])
  @@index([moveOutNoticeId])
  @@index([status, createdAt])
  @@index([moveOutDate])
}

/// Admin-to-admin request to transfer a moved-out tenant record between organisations.
model TenantTransferRequest {
  id                String               @id @default(cuid())
  sourceOrgId       String
  targetOrgId       String
  sourceTenantId    String
  createdTenantId   String?              @unique
  requestedByUserId String
  reviewedByUserId  String?
  status            TenantTransferStatus @default(PENDING)
  message           String?
  reviewNotes       String?
  requestedAt       DateTime             @default(now())
  reviewedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  createdTenant     Tenant?              @relation("TenantTransferCreatedTenant", fields: [createdTenantId], references: [id])
  requestedBy       User                 @relation("TenantTransferRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy        User?                @relation("TenantTransferReviewedBy", fields: [reviewedByUserId], references: [id])
  sourceOrg         Organization         @relation("TenantTransferSourceOrg", fields: [sourceOrgId], references: [id], onDelete: Cascade)
  sourceTenant      Tenant               @relation("TenantTransferSourceTenant", fields: [sourceTenantId], references: [id], onDelete: Cascade)
  targetOrg         Organization         @relation("TenantTransferTargetOrg", fields: [targetOrgId], references: [id], onDelete: Cascade)

  @@unique([sourceTenantId, targetOrgId, status])
  @@index([sourceOrgId, status, requestedAt])
  @@index([targetOrgId, status, requestedAt])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
  @@index([createdTenantId])
}

/// Emergency or next-of-kin contact for a tenant.
model NextOfKin {
  id           String  @id @default(cuid())
  tenantId     String  @unique
  name         String
  relationship String
  phone        String
  email        String?
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Tenancy agreement between a tenant and a unit.
model Lease {
  id                 String                   @id @default(cuid())
  orgId              String
  unitId             String
  tenantId           String
  caretakerUserId    String?
  startDate          DateTime
  endDate            DateTime?
  dueDay             Int                      @default(5)
  monthlyRent        Decimal                  @db.Decimal(12, 2)
  deposit            Decimal?                 @db.Decimal(12, 2)
  status             LeaseStatus              @default(ACTIVE)
  notes              String?
  deletedAt          DateTime?
  contractDocumentId String?                  @unique
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  caretaker          User?                    @relation("LeaseCaretaker", fields: [caretakerUserId], references: [id])
  contractDocument   Asset?                   @relation("LeaseContract", fields: [contractDocumentId], references: [id])
  org                Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit               Unit                     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  moveOutNotices     MoveOutNotice[]
  rentCharges        RentCharge[]
  rentalReturnItems  RentalIncomeReturnItem[]
  taxCharges         TaxCharge[]
  tenantActionLogs   TenantActionLog[]
  signatureEnvelopes LeaseSignatureEnvelope[]

  @@index([orgId])
  @@index([unitId])
  @@index([tenantId])
  @@index([caretakerUserId])
  @@index([status, unitId])
  @@index([status, tenantId])
  @@index([startDate])
  @@index([endDate])
  @@index([deletedAt])
  @@index([orgId, status, deletedAt])
  @@index([orgId, createdAt])
  @@index([orgId, updatedAt])
  @@index([orgId, tenantId, status])
  @@index([orgId, unitId, status])
  @@index([orgId, dueDay, status])
}

model LeaseSignatureEnvelope {
  id                 String                       @id @default(cuid())
  orgId              String
  leaseId            String
  sourceAssetId      String
  finalAssetId       String?
  sourceDocumentHash String
  finalDocumentHash  String?                      @unique
  status             LeaseSignatureEnvelopeStatus @default(PENDING)
  message            String?
  consentVersion     String                       @default("2026-07-02")
  jurisdiction       LeaseSigningJurisdiction     @default(KENYA)
  consentText        String                       @default("I intend to sign this lease electronically and consent to the capture of signing evidence.")
  signingOrder       LeaseSigningOrder            @default(SEQUENTIAL)
  version            Int                          @default(1)
  amendmentOfId      String?
  expiresAt          DateTime
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdByUserId    String
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  org                Organization                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lease              Lease                        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  signers            LeaseSignatureSigner[]
  events             LeaseSignatureEvent[]

  @@index([orgId, status, createdAt])
  @@index([leaseId, createdAt])
  @@index([expiresAt, status])
}

model LeaseSignatureSigner {
  id                 String                 @id @default(cuid())
  envelopeId         String
  userId             String?
  role               LeaseSignerRole
  signingOrder       Int                    @default(1)
  label              String?
  name               String
  email              String?
  phone              String?
  tokenHash          String                 @unique
  status             LeaseSignerStatus      @default(PENDING)
  signatureText      String?
  signatureMethod    LeaseSignatureMethod?
  signatureAssetKey  String?
  signatureImageHash String?
  consentAcceptedAt  DateTime?
  signedAt           DateTime?
  declinedAt         DateTime?
  declineReason      String?
  ipAddress          String?
  userAgent          String?
  lastReminderAt     DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  envelope           LeaseSignatureEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([envelopeId, status])
  @@index([envelopeId, signingOrder])
}

model LeaseSignatureEvent {
  id          String                  @id @default(cuid())
  envelopeId  String
  eventType   LeaseSignatureEventType
  actorUserId String?
  signerId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime                @default(now())
  envelope    LeaseSignatureEnvelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@index([envelopeId, createdAt])
  @@index([eventType, createdAt])
}

/// Caretaker scope assignment for property, building, or unit operations.
model CaretakerAssignment {
  id              String       @id @default(cuid())
  orgId           String
  caretakerUserId String
  propertyId      String?
  buildingId      String?
  isPrimary       Boolean      @default(true)
  active          Boolean      @default(true)
  assignedAt      DateTime     @default(now())
  endedAt         DateTime?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  unitId          String?
  building        Building?    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  caretaker       User         @relation("CaretakerUser", fields: [caretakerUserId], references: [id], onDelete: Cascade)
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property        Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit            Unit?        @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([caretakerUserId])
  @@index([propertyId])
  @@index([buildingId])
  @@index([unitId])
  @@index([active])
  @@index([caretakerUserId, active, propertyId])
  @@index([caretakerUserId, active, buildingId])
  @@index([caretakerUserId, active, unitId])
  @@index([orgId, active, unitId])
  @@index([orgId, active, propertyId])
  @@index([orgId, active, buildingId])
}

/// Landlord profile linked to a user and optional taxpayer profile.
model LandlordProfile {
  id                String               @id @default(cuid())
  orgId             String
  userId            String
  taxpayerProfileId String?
  displayName       String
  phone             String?
  email             String?
  nationalId        String?
  notes             String?
  isActive          Boolean              @default(true)
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  assignments       LandlordAssignment[]
  org               Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  taxpayerProfile   TaxpayerProfile?     @relation(fields: [taxpayerProfileId], references: [id])
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
  @@index([taxpayerProfileId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([orgId, isActive, deletedAt])
}

/// Landlord ownership/management assignment for property or unit.
model LandlordAssignment {
  id                String          @id @default(cuid())
  orgId             String
  landlordProfileId String
  propertyId        String?
  unitId            String?
  isPrimary         Boolean         @default(true)
  active            Boolean         @default(true)
  assignedAt        DateTime        @default(now())
  endedAt           DateTime?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  landlord          LandlordProfile @relation(fields: [landlordProfileId], references: [id], onDelete: Cascade)
  org               Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property          Property?       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit              Unit?           @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([landlordProfileId])
  @@index([propertyId])
  @@index([unitId])
  @@index([active])
  @@index([landlordProfileId, active, propertyId])
  @@index([landlordProfileId, active, unitId])
  @@index([orgId, active, propertyId])
  @@index([orgId, active, unitId])
  @@index([orgId, active, landlordProfileId])
}

/// Periodic rent/deposit/service charge generated from a lease.
model RentCharge {
  id                 String                   @id @default(cuid())
  orgId              String
  leaseId            String
  period             String
  amountDue          Decimal                  @db.Decimal(12, 2)
  dueDate            DateTime
  amountPaid         Decimal                  @default(0) @db.Decimal(12, 2)
  balance            Decimal                  @db.Decimal(12, 2)
  status             ChargeStatus             @default(UNPAID)
  chargeType         ChargeType               @default(RENT)
  description        String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  payments           Payment[]                @relation("PaymentToRentCharge")
  paymentAllocations PaymentAllocation[]
  lease              Lease                    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  org                Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rentalReturnItems  RentalIncomeReturnItem[]
  journalEntryId     String?                  @unique
  accrualJournal     AccountingJournalEntry?  @relation("RentChargeAccrual", fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([leaseId, period, chargeType])
  @@index([orgId])
  @@index([leaseId, status])
  @@index([period, status])
  @@index([dueDate])
  @@index([chargeType])
  @@index([orgId, status, dueDate])
  @@index([orgId, createdAt])
  @@index([orgId, updatedAt])
  @@index([orgId, period, status])
  @@index([orgId, leaseId, period])
}

/// KRA rental income return aggregate for a filing period.
model RentalIncomeReturn {
  id                String                   @id @default(cuid())
  orgId             String
  taxpayerProfileId String?
  propertyId        String?
  filingKey         String                   @unique
  period            String
  regime            RentalTaxRegime          @default(MRI)
  basis             RentalAssessmentBasis    @default(GROSS_RENT_BILLED)
  filingChannel     KraFilingChannel         @default(ERITS_MANUAL)
  status            KraFilingStatus          @default(DRAFT)
  isNilReturn       Boolean                  @default(false)
  grossRent         Decimal                  @db.Decimal(14, 2)
  taxableGrossRent  Decimal                  @db.Decimal(14, 2)
  taxRate           Decimal                  @db.Decimal(7, 4)
  taxDue            Decimal                  @db.Decimal(14, 2)
  currencyCode      String                   @default("KES")
  taxpayerPin       String
  taxpayerName      String?
  eligibilityNotes  String?
  assessmentRef     String?
  kraReturnRef      String?
  kraPaymentRef     String?
  kraReceiptNo      String?
  preparedAt        DateTime?
  submittedAt       DateTime?
  acknowledgedAt    DateTime?
  paidAt            DateTime?
  submittedByUserId String?
  lastError         String?
  rawRequest        Json?
  rawResponse       Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  attempts          KraSubmissionAttempt[]
  linkedPayments    Payment[]                @relation("PaymentToRentalReturn")
  org               Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property          Property?                @relation(fields: [propertyId], references: [id])
  submittedBy       User?                    @relation("RentalReturnSubmittedBy", fields: [submittedByUserId], references: [id])
  taxpayerProfile   TaxpayerProfile?         @relation(fields: [taxpayerProfileId], references: [id])
  items             RentalIncomeReturnItem[]
  linkedTaxCharges  TaxCharge[]

  @@index([orgId, period])
  @@index([taxpayerProfileId])
  @@index([propertyId])
  @@index([status])
  @@index([filingChannel])
  @@index([taxpayerPin])
  @@index([submittedAt])
  @@index([orgId, createdAt])
  @@index([orgId, updatedAt])
  @@index([orgId, period, status])
  @@index([orgId, taxpayerPin, period])
}

/// Line item contributing to a rental income return.
model RentalIncomeReturnItem {
  id             String             @id @default(cuid())
  rentalReturnId String
  propertyId     String
  unitId         String?
  leaseId        String?
  rentChargeId   String?
  description    String?
  grossRent      Decimal            @db.Decimal(14, 2)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  lease          Lease?             @relation(fields: [leaseId], references: [id])
  property       Property           @relation(fields: [propertyId], references: [id])
  rentCharge     RentCharge?        @relation(fields: [rentChargeId], references: [id])
  rentalReturn   RentalIncomeReturn @relation(fields: [rentalReturnId], references: [id], onDelete: Cascade)
  unit           Unit?              @relation(fields: [unitId], references: [id])

  @@index([rentalReturnId])
  @@index([propertyId])
  @@index([unitId])
  @@index([leaseId])
  @@index([rentChargeId])
  @@index([rentalReturnId, propertyId])
  @@index([propertyId, unitId])
}

/// Audit trail for attempts to submit or sync with KRA.
model KraSubmissionAttempt {
  id              String             @id @default(cuid())
  rentalReturnId  String
  channel         KraFilingChannel
  requestPayload  Json?
  responsePayload Json?
  httpStatus      Int?
  outcome         KraAttemptOutcome
  errorMessage    String?
  attemptedAt     DateTime           @default(now())
  rentalReturn    RentalIncomeReturn @relation(fields: [rentalReturnId], references: [id], onDelete: Cascade)

  @@index([rentalReturnId, attemptedAt])
  @@index([outcome])
  @@index([outcome, attemptedAt])
  @@index([channel])
}

/// Water meter reading submitted and optionally approved.
model MeterReading {
  id                String        @id @default(cuid())
  unitId            String
  period            String
  prevReading       Int
  currentReading    Int
  unitsUsed         Int
  status            ReadingStatus @default(SUBMITTED)
  submittedByUserId String
  approvedByUserId  String?
  approvedAt        DateTime?
  rejectionReason   String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  photoAssetId      String?
  approvedBy        User?         @relation("MeterReadingApprovedBy", fields: [approvedByUserId], references: [id])
  photoAsset        Asset?        @relation("MeterPhoto", fields: [photoAssetId], references: [id])
  submittedBy       User          @relation("MeterReadingSubmittedBy", fields: [submittedByUserId], references: [id])
  unit              Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, period])
  @@index([unitId, status])
  @@index([period, status])
  @@index([submittedByUserId, createdAt])
  @@index([status, createdAt])
  @@index([unitId, period, status])
  @@index([approvedByUserId, approvedAt])
}

/// Water bill generated from meter usage for a tenant/unit.
model WaterBill {
  id          String       @id @default(cuid())
  orgId       String
  unitId      String
  tenantId    String
  period      String
  unitsUsed   Int
  ratePerUnit Decimal      @db.Decimal(10, 2)
  fixedCharge Decimal      @default(0) @db.Decimal(10, 2)
  total       Decimal      @db.Decimal(12, 2)
  dueDate     DateTime
  status      BillStatus   @default(ISSUED)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  payments    Payment[]    @relation("PaymentToWaterBill")
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit           Unit                    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  journalEntryId String?                 @unique
  accrualJournal AccountingJournalEntry? @relation("WaterBillAccrual", fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([unitId, period])
  @@index([orgId])
  @@index([tenantId, period])
  @@index([unitId, period])
  @@index([status])
  @@index([dueDate])
  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@index([orgId, updatedAt])
  @@index([orgId, period, status])
  @@index([orgId, dueDate, status])
}

/// Tax obligation or KRA-linked charge.
model TaxCharge {
  id               String              @id @default(cuid())
  orgId            String
  propertyId       String?
  leaseId          String?
  tenantId         String?
  taxType          TaxType
  taxAuthority     String              @default("KRA")
  taxAccountNumber String?
  period           String
  baseAmount       Decimal?            @db.Decimal(12, 2)
  taxRate          Decimal?            @db.Decimal(7, 4)
  amountDue        Decimal             @db.Decimal(12, 2)
  amountPaid       Decimal             @default(0) @db.Decimal(12, 2)
  balance          Decimal             @db.Decimal(12, 2)
  dueDate          DateTime
  status           TaxStatus           @default(PENDING)
  assessmentRef    String?
  kraPaymentRef    String?
  kraReceiptNo     String?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  acknowledgedAt   DateTime?
  filingStatus     KraFilingStatus?
  rawKraResponse   Json?
  rentalReturnId   String?
  submittedAt      DateTime?
  payments         Payment[]           @relation("PaymentToTaxCharge")
  lease            Lease?              @relation(fields: [leaseId], references: [id])
  org              Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property         Property?           @relation(fields: [propertyId], references: [id])
  rentalReturn     RentalIncomeReturn? @relation(fields: [rentalReturnId], references: [id])
  tenant           Tenant?             @relation(fields: [tenantId], references: [id])

  @@index([orgId])
  @@index([propertyId])
  @@index([leaseId])
  @@index([tenantId])
  @@index([rentalReturnId])
  @@index([taxType])
  @@index([status])
  @@index([filingStatus])
  @@index([dueDate])
  @@index([period])
  @@index([orgId, createdAt])
  @@index([orgId, updatedAt])
  @@index([orgId, period, status])
  @@index([orgId, taxType, period])
}

/// Incoming payment record allocated to rent, water, tax, or other target.
model Payment {
  id                      String                      @id @default(cuid())
  orgId                   String
  payerTenantId           String?
  method                  PaymentMethod
  amount                  Decimal                     @db.Decimal(12, 2)
  reference               String?
  externalReference       String?
  transactionReferenceKey String?                     @unique
  targetType              PaymentTargetType
  rentChargeId            String?
  waterBillId             String?
  taxChargeId             String?
  gatewayStatus           GatewayStatus               @default(INITIATED)
  verificationStatus      VerificationStatus          @default(PENDING)
  reconciliationStatus    PaymentReconciliationStatus @default(UNRECONCILED)
  checkoutRequestId       String?                     @unique
  merchantRequestId       String?
  phoneUsed               String?
  callbackRaw             Json?
  paidAt                  DateTime?
  notes                   String?
  remittedToKra           Boolean                     @default(false)
  remittedAt              DateTime?
  kraReference            String?
  kraReceiptNo            String?
  reconciledAt            DateTime?
  reconciledByUserId      String?
  reconciliationNotes     String?
  reversedAt              DateTime?
  reversedByUserId        String?
  reversalReason          String?
  unappliedAmount         Decimal                     @default(0) @db.Decimal(12, 2)
  coveredPeriods          String[]
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  payerName               String?
  payerType               PayerType                   @default(TENANT)
  payerUserId             String?
  rentalReturnId          String?
  org                     Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payerTenant             Tenant?                     @relation("PaymentPayerTenant", fields: [payerTenantId], references: [id], onDelete: Cascade)
  payerUser               User?                       @relation("PaymentPayerUser", fields: [payerUserId], references: [id])
  reconciledBy            User?                       @relation("PaymentReconciledBy", fields: [reconciledByUserId], references: [id])
  reversedBy              User?                       @relation("PaymentReversedBy", fields: [reversedByUserId], references: [id])
  rentCharge              RentCharge?                 @relation("PaymentToRentCharge", fields: [rentChargeId], references: [id])
  rentalReturn            RentalIncomeReturn?         @relation("PaymentToRentalReturn", fields: [rentalReturnId], references: [id])
  taxCharge               TaxCharge?                  @relation("PaymentToTaxCharge", fields: [taxChargeId], references: [id])
  waterBill               WaterBill?                  @relation("PaymentToWaterBill", fields: [waterBillId], references: [id])
  allocations             PaymentAllocation[]
  receipt                 Receipt?

  @@index([orgId, createdAt])
  @@index([payerTenantId, createdAt])
  @@index([payerUserId, createdAt])
  @@index([gatewayStatus, verificationStatus])
  @@index([rentChargeId])
  @@index([waterBillId])
  @@index([taxChargeId])
  @@index([rentalReturnId])
  @@index([reference])
  @@index([externalReference])
  @@index([paidAt])
  @@index([remittedToKra, remittedAt])
  @@index([orgId, gatewayStatus, verificationStatus])
  @@index([orgId, reconciliationStatus, createdAt])
  @@index([orgId, updatedAt])
  @@index([orgId, paidAt])
  @@index([orgId, targetType, createdAt])
  @@index([orgId, method, createdAt])
  @@index([orgId, unappliedAmount])
  @@index([reconciledByUserId, reconciledAt])
  @@index([reversedByUserId, reversedAt])
}

/// Allocation of a single payment across one or many rent charge periods.
model PaymentAllocation {
  id           String       @id @default(cuid())
  orgId        String
  paymentId    String
  rentChargeId String
  amount       Decimal      @db.Decimal(12, 2)
  period       String
  createdAt    DateTime     @default(now())
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  rentCharge   RentCharge   @relation(fields: [rentChargeId], references: [id], onDelete: Cascade)

  @@unique([paymentId, rentChargeId])
  @@index([orgId, period])
  @@index([paymentId])
  @@index([rentChargeId])
}

/// Receipt generated from a verified payment.
model Receipt {
  id         String          @id @default(cuid())
  paymentId  String          @unique
  documentId String?         @unique
  receiptNo  String          @unique
  pdfUrl     String?
  issuedAt   DateTime        @default(now())
  payment    Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  document   DocumentRecord? @relation(fields: [documentId], references: [id], onDelete: SetNull)
}

/// Organization-level accounting configuration and recognition policy.
model AccountingSettings {
  id                   String                    @id @default(cuid())
  orgId                String                    @unique
  recognitionMode      AccountingRecognitionMode @default(ACCRUAL)
  fiscalYearStartMonth Int                       @default(1)
  autoPostPayments              Boolean                   @default(true)
  autoPostBilling               Boolean                   @default(true)
  ownerStatementEmailEnabled    Boolean                   @default(false)
  ownerStatementEmailDayOfMonth Int                       @default(5)
  ownerStatementLastSentAt      DateTime?
  initializedAt                 DateTime?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  org                           Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// Organization-scoped chart of accounts for the double-entry general ledger.
model AccountingAccount {
  id            String                     @id @default(cuid())
  orgId         String
  parentId      String?
  code          String
  name          String
  type          AccountingAccountType
  normalBalance AccountingBalanceSide
  systemKey     String?
  description   String?
  isControl     Boolean                    @default(false)
  isActive      Boolean                    @default(true)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  org           Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent        AccountingAccount?         @relation("AccountingAccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      AccountingAccount[]        @relation("AccountingAccountHierarchy")
  journalLines  AccountingJournalLine[]
  bankAccounts  AccountingBankAccount[]
  budgetLines   AccountingBudgetLine[]
  billLines     AccountingVendorBillLine[]

  @@unique([orgId, code])
  @@unique([orgId, systemKey])
  @@index([orgId, type, isActive])
  @@index([orgId, parentId])
}

/// Lockable fiscal period. Posted entries cannot be added to a closed period.
model AccountingPeriod {
  id             String                   @id @default(cuid())
  orgId          String
  name           String
  startsAt       DateTime
  endsAt         DateTime
  status         AccountingPeriodStatus   @default(OPEN)
  closedAt       DateTime?
  closedByUserId String?
  closeNotes     String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  org            Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  journalEntries AccountingJournalEntry[]
  budgets        AccountingBudget[]

  @@unique([orgId, startsAt, endsAt])
  @@index([orgId, status, startsAt])
}

/// Immutable header for a balanced accounting transaction.
model AccountingJournalEntry {
  id              String                  @id @default(cuid())
  orgId           String
  periodId        String?
  entryNumber     String
  entryDate       DateTime
  description     String
  memo            String?
  status          AccountingJournalStatus @default(DRAFT)
  sourceType      AccountingSourceType
  sourceId        String?
  reversalOfId    String?                 @unique
  postedAt        DateTime?
  postedByUserId  String?
  createdByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  org             Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  period          AccountingPeriod?       @relation(fields: [periodId], references: [id])
  lines           AccountingJournalLine[]
  reversalOf      AccountingJournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy      AccountingJournalEntry? @relation("JournalReversal")
  rentChargeAccrual RentCharge?           @relation("RentChargeAccrual")
  waterBillAccrual  WaterBill?            @relation("WaterBillAccrual")

  @@unique([orgId, entryNumber])
  @@unique([orgId, sourceType, sourceId])
  @@index([orgId, entryDate, status])
  @@index([periodId, status])
}

model AccountingJournalLine {
  id          String                 @id @default(cuid())
  orgId       String
  journalId   String
  accountId   String
  description String?
  debit       Decimal                @default(0) @db.Decimal(14, 2)
  credit      Decimal                @default(0) @db.Decimal(14, 2)
  propertyId  String?
  unitId      String?
  tenantId    String?
  vendorId    String?
  landlordId  String?
  createdAt   DateTime               @default(now())
  journal     AccountingJournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account     AccountingAccount      @relation(fields: [accountId], references: [id])

  @@index([orgId, accountId])
  @@index([journalId])
  @@index([propertyId])
  @@index([unitId])
  @@index([tenantId])
  @@index([vendorId])
}

model AccountingBankAccount {
  id                  String                         @id @default(cuid())
  orgId               String
  ledgerAccountId     String
  name                String
  type                AccountingBankAccountType
  institutionName     String?
  accountNumberMasked String?
  currencyCode        String                         @default("KES")
  openingBalance      Decimal                        @default(0) @db.Decimal(14, 2)
  openingBalanceDate  DateTime?
  lastReconciledAt    DateTime?
  isDefault           Boolean                        @default(false)
  isActive            Boolean                        @default(true)
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  org                 Organization                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ledgerAccount       AccountingAccount              @relation(fields: [ledgerAccountId], references: [id])
  reconciliations     AccountingBankReconciliation[]

  @@unique([orgId, name])
  @@index([orgId, type, isActive])
}

/// GL bank reconciliation session comparing statement balance to ledger.
model AccountingBankReconciliation {
  id                String                             @id @default(cuid())
  orgId             String
  bankAccountId     String
  periodEnd         DateTime
  statementBalance  Decimal                            @db.Decimal(14, 2)
  glBalance         Decimal                            @db.Decimal(14, 2)
  status            AccountingBankReconciliationStatus @default(DRAFT)
  notes             String?
  completedAt       DateTime?
  completedByUserId String?
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt
  org               Organization                       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bankAccount       AccountingBankAccount              @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  items             AccountingBankReconciliationItem[]

  @@index([orgId, bankAccountId, periodEnd])
  @@index([orgId, status, periodEnd])
}

/// Statement line or cleared GL item within a bank reconciliation.
model AccountingBankReconciliationItem {
  id               String                       @id @default(cuid())
  reconciliationId String
  journalLineId    String?
  description      String?
  statementDate    DateTime?
  statementRef     String?
  amount           Decimal                      @db.Decimal(14, 2)
  isCleared        Boolean                      @default(false)
  createdAt        DateTime                     @default(now())
  reconciliation   AccountingBankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId])
  @@index([journalLineId])
}

model AccountingVendor {
  id            String                 @id @default(cuid())
  orgId         String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  kraPin        String?
  address       String?
  paymentTerms  Int                    @default(0)
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  org           Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bills         AccountingVendorBill[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
}

model AccountingTaxCode {
  id               String                     @id @default(cuid())
  orgId            String
  code             String
  name             String
  rate             Decimal                    @db.Decimal(7, 4)
  type             AccountingTaxCodeType
  payableAccountId String?
  isActive         Boolean                    @default(true)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  org              Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  billLines        AccountingVendorBillLine[]

  @@unique([orgId, code])
  @@index([orgId, type, isActive])
}

model AccountingVendorBill {
  id               String                     @id @default(cuid())
  orgId            String
  vendorId         String
  billNumber       String
  billDate         DateTime
  dueDate          DateTime
  status           AccountingBillStatus       @default(DRAFT)
  currencyCode     String                     @default("KES")
  subtotal         Decimal                    @db.Decimal(14, 2)
  taxAmount        Decimal                    @default(0) @db.Decimal(14, 2)
  total            Decimal                    @db.Decimal(14, 2)
  amountPaid       Decimal                    @default(0) @db.Decimal(14, 2)
  propertyId       String?
  unitId           String?
  notes            String?
  attachmentKey    String?
  journalEntryId   String?                    @unique
  createdByUserId  String?
  approvedByUserId String?
  approvedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  org              Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendor           AccountingVendor           @relation(fields: [vendorId], references: [id])
  lines            AccountingVendorBillLine[]

  @@unique([orgId, vendorId, billNumber])
  @@index([orgId, status, dueDate])
  @@index([propertyId])
}

model AccountingVendorBillLine {
  id          String               @id @default(cuid())
  billId      String
  accountId   String
  taxCodeId   String?
  description String
  quantity    Decimal              @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal              @db.Decimal(14, 2)
  taxAmount   Decimal              @default(0) @db.Decimal(14, 2)
  total       Decimal              @db.Decimal(14, 2)
  propertyId  String?
  unitId      String?
  bill        AccountingVendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  account     AccountingAccount    @relation(fields: [accountId], references: [id])
  taxCode     AccountingTaxCode?   @relation(fields: [taxCodeId], references: [id])

  @@index([billId])
  @@index([accountId])
}

model AccountingBudget {
  id               String                 @id @default(cuid())
  orgId            String
  periodId         String
  name             String
  status           AccountingBudgetStatus @default(DRAFT)
  approvedAt       DateTime?
  approvedByUserId String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  org              Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  period           AccountingPeriod       @relation(fields: [periodId], references: [id])
  lines            AccountingBudgetLine[]

  @@unique([orgId, periodId, name])
  @@index([orgId, status])
}

model AccountingBudgetLine {
  id         String            @id @default(cuid())
  budgetId   String
  accountId  String
  propertyId String?
  unitId     String?
  amount     Decimal           @db.Decimal(14, 2)
  budget     AccountingBudget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account    AccountingAccount @relation(fields: [accountId], references: [id])

  @@index([budgetId])
  @@index([accountId])
}

/// Worker-submitted finance ticket routed to accountants for approval.
model AccountingRequest {
  id                String                  @id @default(cuid())
  orgId             String
  requestNumber     String
  type              AccountingRequestType   @default(OTHER)
  status            AccountingRequestStatus @default(SUBMITTED)
  title             String
  description       String
  amount            Decimal                 @db.Decimal(14, 2)
  currencyCode      String                  @default("KES")
  propertyId        String?
  vendorName        String?
  payeeName         String?
  reference         String?
  attachmentKey     String?
  submittedByUserId String
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewerFeedback  String?
  internalNotes     String?
  vendorBillId      String?
  cancelledAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  org               Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  submittedBy       User                    @relation("AccountingRequestSubmittedBy", fields: [submittedByUserId], references: [id])
  reviewedBy        User?                   @relation("AccountingRequestReviewedBy", fields: [reviewedByUserId], references: [id])
  events            AccountingRequestEvent[]

  @@unique([orgId, requestNumber])
  @@index([orgId, status, createdAt])
  @@index([submittedByUserId, createdAt])
  @@index([orgId, submittedByUserId, status])
}

/// Status history and feedback trail for an accounting request.
model AccountingRequestEvent {
  id          String                  @id @default(cuid())
  requestId   String
  actorUserId String?
  status      AccountingRequestStatus
  message     String?
  createdAt   DateTime                @default(now())
  request     AccountingRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor       User?                   @relation("AccountingRequestEventActor", fields: [actorUserId], references: [id])

  @@index([requestId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Auditable expenditure register for platform, organization, and tenant-linked costs.
model Expenditure {
  id               String              @id @default(cuid())
  scope            ExpenditureScope
  orgId            String?
  tenantId         String?
  propertyId       String?
  unitId           String?
  category         ExpenditureCategory
  description      String
  payee            String?
  reference        String?
  amount           Decimal             @db.Decimal(14, 2)
  currencyCode     String
  incurredAt       DateTime
  dueAt            DateTime?
  paidAt           DateTime?
  status           ExpenditureStatus   @default(RECORDED)
  paymentMethod    String?
  chargeable       Boolean             @default(false)
  attachmentKey    String?
  journalEntryId   String?
  createdByUserId  String
  approvedByUserId String?
  approvedAt       DateTime?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  org              Organization?       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tenant           Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([scope, incurredAt])
  @@index([orgId, incurredAt])
  @@index([tenantId, incurredAt])
  @@index([propertyId, incurredAt])
  @@index([status, dueAt])
  @@index([createdByUserId, createdAt])
}

/// User or tenant notification queued/sent through a delivery channel.
model Notification {
  id               String              @id @default(cuid())
  orgId            String
  userId           String?
  tenantId         String?
  channel          NotificationChannel
  type             NotificationType
  title            String
  message          String
  status           NotificationStatus  @default(QUEUED)
  providerResponse Json?
  sentAt           DateTime?
  readAt           DateTime?
  createdAt        DateTime            @default(now())
  org              Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tenant           Tenant?             @relation("NotificationTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?               @relation("NotificationUser", fields: [userId], references: [id])

  @@index([orgId, createdAt])
  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
  @@index([status, channel])
  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([orgId, readAt])
  @@index([orgId, status, createdAt])
  @@index([orgId, channel, status])
  @@index([tenantId, readAt])
}

/// Browser/device Web Push subscription for an authenticated user.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeenAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
}

/// Tenant move-out notice and inspection lifecycle trigger.
model MoveOutNotice {
  id          String       @id @default(cuid())
  leaseId     String
  tenantId    String
  noticeDate  DateTime     @default(now())
  moveOutDate DateTime
  status      NoticeStatus @default(SUBMITTED)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  inspection  Inspection?
  lease       Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([leaseId, status])
  @@index([tenantId, status])
  @@index([moveOutDate])
  @@index([tenantId, moveOutDate])
  @@index([leaseId, moveOutDate])
}

/// Move-out or property inspection record.
model Inspection {
  id              String           @id @default(cuid())
  noticeId        String           @unique
  scheduledAt     DateTime
  inspectorUserId String
  status          InspectionStatus @default(SCHEDULED)
  notes           String?
  checklist       Json?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  inspector       User             @relation("InspectionInspector", fields: [inspectorUserId], references: [id])
  notice          MoveOutNotice    @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([scheduledAt])
  @@index([status])
  @@index([inspectorUserId, scheduledAt])
  @@index([status, scheduledAt])
}

/// Maintenance or operational issue ticket.
model IssueTicket {
  id                String                  @id @default(cuid())
  orgId             String
  propertyId        String?
  unitId            String?
  reportedByUserId  String
  assignedToUserId  String?
  title             String
  description       String
  priority          TicketPriority          @default(MEDIUM)
  status            TicketStatus            @default(OPEN)
  resolutionNotes   String?
  resolvedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  photoAssetId      String?
  assignedByUserId  String?
  assignedBy        User?                   @relation("IssueAssignedBy", fields: [assignedByUserId], references: [id])
  assignedTo        User?                   @relation("IssueAssignedTo", fields: [assignedToUserId], references: [id])
  org               Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  photoAsset        Asset?                  @relation("IssuePhoto", fields: [photoAssetId], references: [id])
  property          Property?               @relation(fields: [propertyId], references: [id])
  reportedBy        User                    @relation("IssueReportedBy", fields: [reportedByUserId], references: [id])
  resolutionReports IssueResolutionReport[]
  unit              Unit?                   @relation(fields: [unitId], references: [id])

  @@index([orgId, status, priority])
  @@index([propertyId])
  @@index([unitId])
  @@index([reportedByUserId])
  @@index([assignedToUserId])
  @@index([assignedByUserId])
  @@index([resolvedAt])
  @@index([orgId, createdAt])
  @@index([orgId, updatedAt])
  @@index([orgId, assignedToUserId, status])
  @@index([orgId, propertyId, status])
  @@index([orgId, unitId, status])
}

/// Caretaker completion report that must be reviewed by office and confirmed by tenant before closure.
model IssueResolutionReport {
  id                      String                      @id @default(cuid())
  issueId                 String
  orgId                   String
  caretakerUserId         String
  officeReviewedByUserId  String?
  tenantConfirmedByUserId String?
  status                  IssueResolutionReportStatus @default(SUBMITTED)
  workSummary             String
  materialsUsed           String?
  tenantInstructions      String?
  officeNotes             String?
  tenantFeedback          String?
  submittedAt             DateTime                    @default(now())
  officeReviewedAt        DateTime?
  tenantConfirmedAt       DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  caretaker               User                        @relation("IssueResolutionReportCaretaker", fields: [caretakerUserId], references: [id])
  issue                   IssueTicket                 @relation(fields: [issueId], references: [id], onDelete: Cascade)
  officeReviewedBy        User?                       @relation("IssueResolutionReportOfficeReviewer", fields: [officeReviewedByUserId], references: [id])
  org                     Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tenantConfirmedBy       User?                       @relation("IssueResolutionReportTenantConfirmer", fields: [tenantConfirmedByUserId], references: [id])

  @@index([issueId, status])
  @@index([orgId, status, submittedAt])
  @@index([caretakerUserId, submittedAt])
  @@index([tenantConfirmedByUserId, tenantConfirmedAt])
}

/// Immutable audit trail for organization actions.
model AuditLog {
  id          String        @id @default(cuid())
  orgId       String?
  actorUserId String
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  beforeState Json?
  afterState  Json?
  ip          String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime      @default(now())
  actor       User          @relation("AuditActor", fields: [actorUserId], references: [id])
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([orgId, action, createdAt])
  @@index([orgId, entityType, createdAt])
  @@index([requestId])
}

/// Execution history for platform cron jobs and manual job runs.
model CronJobRun {
  id             String        @id @default(cuid())
  jobName        String
  endpoint       String?
  triggerSource  String
  status         CronJobStatus @default(RUNNING)
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  processedCount Int           @default(0)
  successCount   Int           @default(0)
  failedCount    Int           @default(0)
  metadata       Json?
  error          String?
  actorUserId    String?
  actor          User?         @relation("CronJobRunActor", fields: [actorUserId], references: [id])

  @@index([jobName, startedAt])
  @@index([status, startedAt])
  @@index([startedAt])
  @@index([actorUserId, startedAt])
}

/// Tenant lifecycle action history.
model TenantActionLog {
  id          String           @id @default(cuid())
  orgId       String
  tenantId    String
  leaseId     String?
  unitId      String?
  actorUserId String
  action      TenantActionType
  reason      String?
  notes       String?
  metadata    Json?
  createdAt   DateTime         @default(now())
  actor       User             @relation("TenantActionActor", fields: [actorUserId], references: [id])
  lease       Lease?           @relation(fields: [leaseId], references: [id])
  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit        Unit?            @relation(fields: [unitId], references: [id])

  @@index([orgId, tenantId, createdAt])
  @@index([tenantId, createdAt])
  @@index([leaseId])
  @@index([unitId])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([orgId, action, createdAt])
  @@index([orgId, actorUserId, createdAt])
}

/// Organization invite token for staff or tenant onboarding.
model Invitation {
  id             String           @id @default(cuid())
  orgId          String
  email          String
  role           OrgRole
  scopeType      ScopeType        @default(ORG)
  scopeId        String           @default("ORG_SCOPE")
  token          String           @unique
  expiresAt      DateTime
  status         InvitationStatus @default(PENDING)
  invitedById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deliveryMeta   Json?
  emailSentAt    DateTime?
  phone          String?
  whatsappSentAt DateTime?
  invitedBy      User             @relation("InvitedBy", fields: [invitedById], references: [id])
  org            Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
  @@index([phone])
  @@index([token])
  @@index([expiresAt])
  @@index([orgId, status])
  @@index([orgId, role, status])
}

/// Password reset token with expiry and usage tracking.
model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@index([usedAt])
}

/// Email verification token with expiry and usage tracking.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@index([usedAt])
}

/// Organization API key metadata; stores only a key hash.
model ApiKey {
  id          String       @id @default(cuid())
  orgId       String
  name        String
  keyHash     String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  permissions Json?
  isActive    Boolean      @default(true)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   User         @relation("CreatedBy", fields: [createdById], references: [id])
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([isActive])
  @@index([orgId, isActive, createdAt])
}

